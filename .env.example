# Connection string de Postgres (Neon, Supabase, local, etc.)
DATABASE_URL="postgresql://user:password@localhost:5432/pagos?schema=public"

# Secreto de NextAuth. Genera uno con: openssl rand -base64 32
AUTH_SECRET=""

# Usuario único de la app (se crea al correr `npm run db:seed`).
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Email de recordatorios (https://resend.com). Deja vacío para desactivar el envío.
RESEND_API_KEY=""
EMAIL_FROM="Pagos <onboarding@resend.dev>"

# Notificaciones push del navegador. Genera con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:tu-email@ejemplo.com"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""

# Días de anticipación para avisar de un pago fijo próximo a vencer.
NOTIFY_DAYS_BEFORE="3"

# Protege /api/cron/notify cuando se invoca manualmente. Vercel Cron ya
# manda este valor automáticamente en el header Authorization.
CRON_SECRET=""

# Protege /api/setup (crea el usuario admin + categorías por defecto una sola
# vez después de desplegar). Genera uno con: openssl rand -hex 16
SETUP_SECRET=""

# Lectura de estados de cuenta en PDF con Gemini. La capa gratuita alcanza de
# sobra para uso personal. Obtén la llave en https://aistudio.google.com/apikey
# Si se deja vacía, la importación de CSV sigue funcionando y solo se desactiva
# la lectura de PDFs.
GEMINI_API_KEY=""
# Opcional: el id del modelo. Por defecto usa el Flash vigente.
GEMINI_MODEL=""
