generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  MEMBER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  // El ADMIN es el único que puede dar de alta a otros. El primero que se
  // crea lo es; el resto entra como MEMBER.
  role         UserRole @default(MEMBER)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt @default(now())

  pushSubscriptions PushSubscription[]

  // Cada quien lleva sus propias finanzas: las categorías y las etiquetas son
  // un catálogo común, pero todo lo que tiene dinero es de una sola persona.
  transactions  Transaction[]
  accounts      Account[]
  fixedPayments FixedPayment[]
  budgets       Budget[]
  debts         Debt[]
  goals         SavingsGoal[]
  imports       StatementImport[]
  subscriptions Subscription[]
  dismissals    InsightDismissal[]
  reminders     ReminderSent[]
}

model Category {
  id        String   @id @default(cuid())
  name      String
  color     String   @default("#0a84ff")
  icon      String?
  parentId  String?
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children  Category[] @relation("CategoryTree")
  // Marca los gastos indispensables (renta, servicios, comida): son la base
  // del cálculo de meses de fondo de emergencia.
  essential Boolean  @default(false)
  archived  Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  transactions  Transaction[]
  fixedPayments FixedPayment[]
  budgets       Budget[]
  rules         CategoryRule[]

  @@index([parentId])
}

enum TxKind {
  EXPENSE
  INCOME
  TRANSFER
}

enum TxSource {
  MANUAL
  IMPORTED
  RECURRING
}

model Transaction {
  id          String   @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind        TxKind   @default(EXPENSE)
  // Siempre positivo: el signo lo determina `kind`.
  amount      Decimal  @db.Decimal(12, 2)
  date        DateTime
  description String?
  note        String?
  // Nombre del comercio normalizado ("OXXO", "SPOTIFY"). Es la llave que
  // comparten las reglas, el dedupe y la detección de suscripciones.
  merchantKey String?
  source      TxSource @default(MANUAL)
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  accountId         String?
  account           Account? @relation("AccountTransactions", fields: [accountId], references: [id], onDelete: SetNull)
  // Solo se usa cuando kind = TRANSFER: la cuenta destino.
  transferAccountId String?
  transferAccount   Account? @relation("AccountTransfers", fields: [transferAccountId], references: [id], onDelete: SetNull)

  excludeFromStats Boolean @default(false)
  externalId       String?
  dedupeHash       String?
  // De qué importación salió. Sin llave foránea a propósito: borrar una
  // importación no debe borrar movimientos ya aprobados.
  importId         String?

  tags Tag[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // El id externo solo tiene que ser único dentro de las finanzas de cada
  // quien: dos personas pueden importar el mismo movimiento de un banco.
  @@unique([userId, externalId])
  @@index([userId, date])
  @@index([categoryId])
  @@index([accountId, date])
  @@index([userId, merchantKey])
  @@index([dedupeHash])
}

model Tag {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  color     String   @default("#8e8e93")
  createdAt DateTime @default(now())

  transactions Transaction[]
}

enum AccountType {
  CHECKING
  SAVINGS
  CASH
  CREDIT_CARD
  INVESTMENT
  LOAN
}

model Account {
  id          String      @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  type        AccountType
  institution String?
  last4       String?
  // El saldo actual se calcula como initialBalance + Σ movimientos firmados.
  // Nunca se almacena, para que no se desincronice de los movimientos.
  initialBalance Decimal  @db.Decimal(14, 2) @default(0)
  creditLimit    Decimal? @db.Decimal(14, 2)
  // Solo para tarjetas de crédito: el día del mes en que cierra el periodo y
  // el día en que vence el pago. De aquí salen los recordatorios.
  cutoffDay      Int?
  paymentDueDay  Int?
  includeInNetWorth Boolean @default(true)
  // Cuenta disponible de inmediato: alimenta "disponible para gastar" y el
  // fondo de emergencia.
  liquid      Boolean  @default(true)
  archived    Boolean  @default(false)
  color       String   @default("#0a84ff")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  transactions      Transaction[]            @relation("AccountTransactions")
  incomingTransfers Transaction[]            @relation("AccountTransfers")
  snapshots         AccountBalanceSnapshot[]
  goals             SavingsGoal[]
  imports           StatementImport[]
  fixedPayments     FixedPayment[]

  @@index([userId])
}

model AccountBalanceSnapshot {
  id        String   @id @default(cuid())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  date      DateTime
  balance   Decimal  @db.Decimal(14, 2)
  source    String   @default("COMPUTED")
  createdAt DateTime @default(now())

  @@unique([accountId, date])
  @@index([date])
}

enum ImportStatus {
  UPLOADED
  EXTRACTING
  READY
  PARTIAL
  FAILED
  COMPLETED
}

model StatementImport {
  id       String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileName String
  // sha256 del archivo: impide subir dos veces el mismo estado de cuenta.
  fileHash String
  mimeType String
  parser   String

  accountId String?
  account   Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  status ImportStatus @default(UPLOADED)
  error  String?

  periodStart    DateTime?
  periodEnd      DateTime?
  openingBalance Decimal?  @db.Decimal(14, 2)
  closingBalance Decimal?  @db.Decimal(14, 2)

  // Respuesta cruda del extractor: permite reconstruir la bandeja sin volver
  // a llamar al modelo.
  rawResponse Json?

  createdAt   DateTime  @default(now())
  processedAt DateTime?

  rows StagedTransaction[]

  @@unique([userId, fileHash])
  @@index([userId, status])
}

enum StagedStatus {
  PENDING
  APPROVED
  REJECTED
  DUPLICATE
}

model StagedTransaction {
  id       String          @id @default(cuid())
  importId String
  import   StatementImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  rowIndex       Int
  rawDescription String
  date           DateTime
  amount         Decimal  @db.Decimal(12, 2)
  kind           TxKind   @default(EXPENSE)
  merchantKey    String?

  suggestedCategoryId String?
  confidence          Decimal? @db.Decimal(3, 2)
  matchedRuleId       String?

  status StagedStatus @default(PENDING)
  // Movimiento existente con el que podría estar duplicado. Sin llave foránea:
  // es solo una señal para la revisión.
  duplicateOfId String?
  // Se llena al aprobar. Es único para que un doble clic no duplique.
  transactionId String? @unique

  createdAt DateTime @default(now())

  @@index([importId, status])
}

enum RuleMatch {
  CONTAINS
  STARTS_WITH
  EXACT
  REGEX
}

model CategoryRule {
  id         String    @id @default(cuid())
  pattern    String
  matchType  RuleMatch @default(CONTAINS)
  categoryId String
  category   Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  priority   Int       @default(0)
  active     Boolean   @default(true)
  // true cuando la regla nació de una corrección del usuario en la bandeja.
  learned    Boolean   @default(false)
  hitCount   Int       @default(0)
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([pattern, matchType])
  @@index([categoryId])
}

enum SubscriptionStatus {
  DETECTED
  CONFIRMED
  DISMISSED
}

model Subscription {
  id             String             @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  merchantKey    String
  label          String
  lastAmount     Decimal            @db.Decimal(12, 2)
  previousAmount Decimal?           @db.Decimal(12, 2)
  cadenceDays    Int
  occurrences    Int
  lastChargeAt   DateTime
  status         SubscriptionStatus @default(DETECTED)
  fixedPaymentId String?            @unique
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([userId, merchantKey])
}

model SavingsGoal {
  id           String    @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  targetAmount Decimal   @db.Decimal(14, 2)
  targetDate   DateTime?
  accountId    String?
  account      Account?  @relation(fields: [accountId], references: [id], onDelete: SetNull)
  color        String    @default("#30d158")
  archived     Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  contributions GoalContribution[]

  @@index([userId])
}

model GoalContribution {
  id        String      @id @default(cuid())
  goalId    String
  goal      SavingsGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  amount    Decimal     @db.Decimal(12, 2)
  date      DateTime    @default(now())
  note      String?
  createdAt DateTime    @default(now())

  @@index([goalId])
}

// Avisos que el usuario ya descartó, identificados por una clave estable. Nació
// para los insights del dashboard y hoy la comparte toda la campana de avisos
// (pagos, tarjetas, importaciones), con la clave namespaced por tipo. Se
// conserva el nombre para no arrastrar una migración de renombrado.
model InsightDismissal {
  id          String   @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  key         String
  dismissedAt DateTime @default(now())

  @@unique([userId, key])
}

enum PaymentFrequency {
  MONTHLY
  WEEKLY
  YEARLY
}

model FixedPayment {
  id            String           @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  amount        Decimal          @db.Decimal(12, 2)
  // EXPENSE para lo que hay que pagar, INCOME para entradas fijas como el
  // sueldo. El cron de avisos solo notifica los de tipo EXPENSE.
  kind          TxKind           @default(EXPENSE)
  dueDay        Int
  dueMonth      Int?
  frequency     PaymentFrequency @default(MONTHLY)
  active        Boolean          @default(true)
  categoryId    String?
  category      Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  // Con qué cuenta se paga, para saber de dónde va a salir el dinero.
  accountId     String?
  account       Account?         @relation(fields: [accountId], references: [id], onDelete: SetNull)
  lastPaidAt    DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([userId, active])
  @@index([categoryId])
}

enum DebtType {
  OWE
  OWED
}

model Debt {
  id            String   @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  counterparty  String?
  type          DebtType
  totalAmount   Decimal  @db.Decimal(12, 2)
  interestRate  Decimal? @db.Decimal(5, 2)
  startDate     DateTime @default(now())
  note          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  payments DebtPayment[]

  @@index([userId])
}

model DebtPayment {
  id        String   @id @default(cuid())
  debtId    String
  debt      Debt     @relation(fields: [debtId], references: [id], onDelete: Cascade)
  amount    Decimal  @db.Decimal(12, 2)
  date      DateTime @default(now())
  note      String?
  createdAt DateTime @default(now())

  @@index([debtId])
}

model Budget {
  id         String   @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  amount     Decimal  @db.Decimal(12, 2)
  month      Int
  year       Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, categoryId, month, year])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

enum ReminderKind {
  FIXED_PAYMENT
  CARD_PAYMENT
}

// Un aviso enviado. Antes esto era un `lastNotifiedAt` en el pago fijo, que
// solo distinguía "ya avisé hoy": con recordatorios a dos y a un día de
// anticipación hacen falta dos eventos distintos. El único compuesto hace que
// el cron pueda correr de más sin duplicar avisos ni perder ninguno.
model ReminderSent {
  id         String       @id @default(cuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind       ReminderKind
  // Id del pago fijo o de la tarjeta. Sin llave foránea: si se borra el pago,
  // el histórico de avisos no tiene por qué estorbar.
  refId      String
  dueDate    DateTime     @db.Date
  daysBefore Int
  sentAt     DateTime     @default(now())

  @@unique([kind, refId, dueDate, daysBefore])
  @@index([userId, sentAt])
}
